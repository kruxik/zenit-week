{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.git/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./package-lock.json)",

      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.vercel/**)",

      "Read(./private/**)",

      "Read(./og-image.svg)",
      "Read(./og-image-cs.svg)",
      "Read(./screenshot.svg)",
      "Read(./assets/hero.svg)",
      "Read(./assets/mockup-*.svg)",
      "Read(**/*.png)",
      "Read(**/*.jpg)",
      "Read(**/*.jpeg)",
      "Read(**/*.gif)",
      "Read(**/*.webp)",
      "Read(**/*.ico)",
      "Read(**/*.woff)",
      "Read(**/*.woff2)",
      "Read(**/*.pdf)",
      "Read(**/*.zip)",

      "Read(./CHANGELOG.md)",
      "Read(**/.DS_Store)",
      "Read(**/*.swp)",
      "Read(**/*.swo)"
    ]
  }
}
