# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
#
# Consumers:
#   - api/token.js (Vercel Edge Function) — loaded automatically by `vercel dev`
#   - npm scripts (e.g. `npm run tunnel`) — loaded via dotenv-cli
#
# Local dev: run `npm run dev` (wraps `vercel dev`) instead of opening the HTML
# file directly.

# --- Google OAuth (required for Drive sync) -----------------------------------
# Create your own OAuth 2.0 credentials at:
#   https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URIs: http://localhost:3000/app
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- ngrok (optional, only for cross-device / HTTPS testing) ------------------
# Reserve a static domain at https://dashboard.ngrok.com/domains (free tier
# includes one). Also add https://<your-domain>/app to the OAuth redirect URIs.
# Used by: `npm run tunnel` and `npm run dev:tunnel`.
# NGROK_DOMAIN=your-name.ngrok-free.dev
