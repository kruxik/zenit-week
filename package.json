{
  "name": "zenit-week",
  "version": "1.0.0",
  "description": "A free online weekly planner app, laid out as a mind map. Plan meaningful work, family and hobbies first, and fit the rest around them. No signup.",
  "type": "module",
  "homepage": "https://zenitweek.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruxik/zenit-week.git"
  },
  "bugs": "https://github.com/kruxik/zenit-week/issues",
  "keywords": [
    "weekly-planner",
    "planner",
    "mind-map",
    "productivity",
    "local-first",
    "offline-first",
    "pwa",
    "time-management"
  ],
  "author": {
    "name": "Petr Burian",
    "email": "petr@petrburian.com",
    "url": "https://www.petrburian.com/"
  },
  "license": "MIT",
  "scripts": {
    "validate": "html-validate zenit-week.html index.html privacy.html terms.html cs/index.html",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "tunnel": "dotenv -e .env.local -- sh -c 'ngrok http --url=${NGROK_DOMAIN:?Set NGROK_DOMAIN in .env.local (see .env.local.example)} 3000'",
    "tunnel:log": "dotenv -e .env.local -- sh -c 'ngrok http --url=${NGROK_DOMAIN:?Set NGROK_DOMAIN in .env.local (see .env.local.example)} --log=stdout --log-format=term --log-level=info 3000'",
    "dev:tunnel": "npx -y concurrently -k -n vercel,ngrok -c blue,magenta \"npx vercel dev\" \"npm run tunnel:log\"",
    "screenshots": "node scripts/screenshots.mjs",
    "hero": "node scripts/hero.mjs",
    "hero:svg": "node scripts/hero-svg.mjs",
    "og": "node scripts/og-image.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "build": "node scripts/inject-playground-seed.mjs && node scripts/inject-version.js && node scripts/csp-hashes.mjs",
    "csp": "node scripts/csp-hashes.mjs",
    "editor:build": "node scripts/build-editor.mjs",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "git-cliff": "^2.13.1",
    "html-validate": "^9.0.0",
    "msw": "^2.14.2",
    "playwright": "^1.59.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "vitest": "^4.1.5"
  }
}
